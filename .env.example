NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_DEFAULT_CURRENCY=GBP

# Optional: local demo is enabled by default when Supabase is not configured.
# Set this to false to disable demo sign-in.
NEXT_PUBLIC_DEMO_MODE=

# Optional server-only email delivery settings. Never prefix these with NEXT_PUBLIC_.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional server-only canonical URL for notification links; defaults to the request origin.
SITE_URL=
